<%- include("partials/head", { pageTitle, active: "game" }) %>

<section class="hero">
  <p class="eyebrow">Lumen Library protocol drill</p>
  <h1>Compose real HTTP requests.</h1>
  <p>
    Each stage describes an action in the library catalog. Choose the method, path, query, and
    body, then send. The server grades you. There are <%= totalStages %> stages — no page reloads
    between them.
  </p>
</section>

<div class="game-layout">
  <aside class="panel stages-panel">
    <div class="panel-head">
      <h2>Stages</h2>
      <p id="stage-counter" class="counter">Stage — of <%= totalStages %></p>
    </div>
    <ol id="stage-list" class="stage-list"></ol>
    <div class="score-box">
      <div>
        <span class="label">Score</span>
        <strong id="score-value">0</strong>
      </div>
      <div>
        <span class="label">Attempts this stage</span>
        <strong id="attempt-value">0</strong>
      </div>
    </div>
    <button type="button" id="reset-progress" class="btn btn-ghost">Reset progress &amp; catalog</button>
  </aside>

  <section class="panel play-panel">
    <p id="stage-kicker" class="eyebrow">Current stage</p>
    <h2 id="stage-title">Loading…</h2>
    <p id="stage-briefing" class="briefing"></p>
    <p id="stage-hint" class="hint" hidden></p>
    <button type="button" id="toggle-hint" class="text-btn">Show hint</button>

    <form id="request-form" class="request-form" autocomplete="off">
      <div class="field-row">
        <label>
          HTTP Method
          <select id="method" name="method">
            <option>GET</option>
            <option>POST</option>
            <option>PUT</option>
            <option>PATCH</option>
            <option>DELETE</option>
          </select>
        </label>
        <label class="grow">
          Path
          <input
            id="path"
            name="path"
            type="text"
            spellcheck="false"
            placeholder="/api/books"
          />
        </label>
      </div>

      <fieldset class="fieldset">
        <legend>Query parameters</legend>
        <p class="field-help">Leave empty when the stage does not need a query string. Add more than one pair when required.</p>
        <div id="query-rows" class="kv-list"></div>
        <button type="button" id="add-query" class="btn btn-small">Add query parameter</button>
      </fieldset>

      <label>
        Request body (JSON)
        <textarea
          id="body"
          name="body"
          rows="8"
          spellcheck="false"
          placeholder='{ "title": "..." }'
        ></textarea>
      </label>

      <p class="preview-label">Request preview</p>
      <pre id="request-preview" class="code-block preview"></pre>

      <div class="actions">
        <button type="submit" class="btn btn-primary">Send request</button>
        <button type="button" id="next-stage" class="btn btn-next" hidden>Next stage</button>
      </div>
    </form>

    <section id="response-panel" class="response-block" aria-live="polite" hidden>
      <div class="panel-head">
        <h3>Server response</h3>
        <span id="status-pill" class="status-pill">waiting</span>
      </div>
      <p id="response-note" class="response-note" hidden>Your last request on this stage.</p>
      <p id="game-feedback" class="feedback"></p>
      <pre id="response-body" class="code-block"></pre>
    </section>
  </section>
</div>

<script src="/js/game.js" defer></script>
<%- include("partials/foot") %>
